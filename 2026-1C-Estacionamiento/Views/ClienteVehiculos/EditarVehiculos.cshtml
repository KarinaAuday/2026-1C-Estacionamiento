@model _2026_1C_Estacionamiento.ViewModel.EditarVehiculosViewModel

@{
    ViewData["Title"] = "Editar Vehículos";
}

<h1>Editar Vehículos</h1>
<h4>Cliente: <strong>@Model.ClienteNombre</strong></h4>
<hr />

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Mensaje"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">
    <!-- Columna izquierda: Asociar nuevo vehículo -->
    <div class="col-md-5">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Asociar Nuevo Vehículo</h5>
            </div>
            <div class="card-body">
                <form asp-action="AsociarVehiculo" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="clienteId" value="@Model.ClienteId" />

                    <div class="mb-3">
                        <label for="vehiculoId" class="form-label">Seleccionar Vehículo (Patente):</label>
                        <select name="vehiculoId" id="vehiculoId" class="form-select" required>
                            <option value="">-- Seleccione una patente --</option>
                            @foreach (var vehiculo in Model.VehiculosDisponibles)
                            {
                                <option value="@vehiculo.Value">@vehiculo.Text</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="responsablePrincipal" class="form-label">Responsable:</label>
                        <input type="text" name="responsablePrincipal" id="responsablePrincipal"
                               class="form-control" value="Titular" required />
                        <small class="form-text text-muted">Ej: Titular, Familiar, Empleado, etc.</small>
                    </div>

                    @if (Model.VehiculosDisponibles.Any())
                    {
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-plus-circle"></i> Asociar Vehículo
                        </button>
                    }
                    else
                    {
                        <div class="alert alert-warning mb-0">
                            No hay vehículos disponibles para asociar.
                            <a asp-controller="Vehiculos" asp-action="Create" class="alert-link">Crear nuevo vehículo</a>
                        </div>
                    }
                </form>
            </div>
        </div>

        <div class="mt-3">
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Volver al Listado
            </a>
        </div>
    </div>

    <!-- Columna derecha: Vehículos asociados -->
    <div class="col-md-7">
        <div class="card">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0">Vehículos Asociados (@Model.VehiculosAsociados.Count)</h5>
            </div>
            <div class="card-body">
                @if (Model.VehiculosAsociados.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Patente</th>
                                    <th>Marca</th>
                                    <th>Color</th>
                                    <th>Responsable</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var vehiculo in Model.VehiculosAsociados)
                                {
                                    <tr>
                                        <td>
                                            <span class="badge bg-dark">@vehiculo.Patente</span>
                                        </td>
                                        <td>@vehiculo.Marca</td>
                                        <td>@vehiculo.Color</td>
                                        <td>
                                            <form asp-action="ActualizarResponsable" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@vehiculo.ClienteVehiculoId" />
                                                <input type="hidden" name="clienteId" value="@Model.ClienteId" />
                                                <div class="input-group input-group-sm">
                                                    <input type="text" name="responsablePrincipal"
                                                           value="@vehiculo.ResponsablePrincipal"
                                                           class="form-control form-control-sm" />
                                                    <button type="submit" class="btn btn-sm btn-outline-primary"
                                                            title="Actualizar responsable">
                                                        <i class="bi bi-check"></i>
                                                    </button>
                                                </div>
                                            </form>
                                        </td>
                                        <td>
                                            <form asp-action="DesasociarVehiculo" method="post" class="d-inline"
                                                  onsubmit="return confirm('¿Está seguro de desasociar este vehículo?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@vehiculo.ClienteVehiculoId" />
                                                <input type="hidden" name="clienteId" value="@Model.ClienteId" />
                                                <button type="submit" class="btn btn-sm btn-danger"
                                                        title="Desasociar vehículo">
                                                    <i class="bi bi-trash"></i> Desasociar
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-info mb-0">
                        <i class="bi bi-info-circle"></i> Este cliente no tiene vehículos asociados.
                    </div>
                }
            </div>
        </div>
    </div>
</div>