@model IEnumerable<_2026_1C_Estacionamiento.Models.Cliente>

@{
    ViewData["Title"] = "Clientes y Vehículos";
}

<h1>Gestión de Clientes y Vehículos</h1>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Mensaje"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<p>
    <a asp-controller="Clientes" asp-action="Create" class="btn btn-primary">Crear Nuevo Cliente</a>
</p>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Cliente</th>
            <th>DNI</th>
            <th>CUIT</th>
            <th>Vehículos Asociados</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var cliente in Model)
        {
            <tr>
                <td>
                    <strong>@cliente.Nombre @cliente.Apellido</strong><br />
                    <small class="text-muted">@cliente.Email</small>
                </td>
                <td>@cliente.Dni</td>
                <td>@cliente.Cuit</td>
                <td>
                    @if (cliente.ClienteVehiculos != null && cliente.ClienteVehiculos.Any(cv => cv.Activo))
                    {
                        <ul class="list-unstyled mb-0">
                            @foreach (var cv in cliente.ClienteVehiculos.Where(cv => cv.Activo))
                            {
                                <li>
                                    <span class="badge bg-secondary">@cv.Vehiculo.Patente</span>
                                    @cv.Vehiculo.Marca - @cv.Vehiculo.Color
                                    <small class="text-muted">(@cv.ResponsablePrincipal)</small>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <span class="text-muted">Sin vehículos asociados</span>
                    }
                </td>
                <td>
                    <a asp-action="EditarVehiculos" asp-route-id="@cliente.Id" class="btn btn-sm btn-warning">
                        <i class="bi bi-pencil"></i> Editar Vehículos
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No hay clientes registrados. <a asp-controller="Clientes" asp-action="Create">Crear el primero</a>
    </div>
}