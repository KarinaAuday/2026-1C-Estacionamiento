<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - _2026_1C_Estacionamiento</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @* <link rel="stylesheet" href="~/_2026_1C_Estacionamiento.styles.css" asp-append-version="true" /> *@
    <link rel="stylesheet" href="~/css/MisEstilos.css" asp-append-version="true" />
</head>
<body>
    <header>
       @*  <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
       *@     
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light  bg-gradient border-bottom box-shadow mb-3 nav-k">
       <div class="container-fluid">
                       <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                            <img src="~/img/ParkingIcon.png" alt="Parking" style="height: 40px; width: 40px;" />
                        </a>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                       
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home"  asp-action="Pruebas1">Pruebas</a>
                        </li>
                        <li class="nav-item">
                       
                            <a class="nav-link text-dark" asp-area="" asp-controller ="Vehiculos" asp-action="Index">Vehiculos</a>
                        </li>
                        <li class="nav-item">
                       
                            <a class="nav-link text-dark" asp-area="" asp-controller="Clientes" asp-action="Index">Clientes</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        @* <p> ANTES DE LA VISTA </p> *@
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
        @* <p> DESPUES DE LA VISTA </p> *@
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
